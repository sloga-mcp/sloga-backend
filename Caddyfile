# Sloga reverse proxy
# Upstreams use 127.0.0.1 (caddy + all backends share one WSL netns). Do NOT hardcode the
# WSL eth0 IP here — it changes with WSL networking mode (was 127.0.0.1 under NAT; the
# switch to mirrored mode on 2026-07-08 made that IP unreachable → every route 502'd).

# Global logging — redact credentials BEFORE they reach disk.
# Session tokens ride in the /ws query string (the browser WebSocket API cannot
# set request headers, so the token has to go in the URL) and in X-Session-Token
# on REST calls. Without this filter, every error entry writes a live, replayable
# session token into /var/log/caddy.log — anyone who can read that file can hijack
# those sessions. `wrap json` preserves the existing on-disk log format.
{
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                }
                request>headers>X-Session-Token delete
                request>headers>Authorization delete
                request>headers>Cookie delete
                # Client addresses (audit 2026-09-06). An http.log.error entry
                # stores the whole request, and behind the tunnel the visitor's
                # address arrives in these headers, so every backend hiccup was
                # writing caller IPs to disk. The privacy page promises that
                # addresses are never written to log files; keep that true here.
                # remote_ip is also a top-level field on admin/tls entries.
                request>headers>Cf-Connecting-Ip delete
                request>headers>X-Forwarded-For delete
                request>headers>True-Client-Ip delete
                request>headers>Cf-Pseudo-Ipv4 delete
                request>headers>Cf-Ipcountry delete
                request>headers>User-Agent delete
                request>remote_ip replace REDACTED
                request>client_ip replace REDACTED
                remote_ip replace REDACTED
            }
        }
    }
}

:80 {

    # WebSocket (Bonfire)
    handle /ws {
        reverse_proxy 127.0.0.1:14703
    }

    # LiveKit RoomService admin API: server-side only (delta/voice-ingress
    # reach LiveKit directly, never through this proxy) — auth-gated by the
    # API secret, but there is no reason to expose the admin surface at all.
    handle /livekit/twirp/* {
        respond 403
    }

    # LiveKit voice (strip /livekit prefix, handles both /livekit and /livekit/*)
    handle /livekit* {
        uri strip_prefix /livekit
        reverse_proxy 127.0.0.1:7880
    }

    # LiveKit webhooks from REMOTE media nodes -> voice-ingress (:8500). The NJ
    # node posts to host.docker.internal:8500 directly and never comes through
    # here. Double-gated: source IP via CF-Connecting-IP (the tunnel means
    # remote_ip is always Cloudflare) AND LiveKit's signed Authorization JWT,
    # which voice-ingress verifies against that node's key before acting.
    @lk_webhook_brazil {
        path /voice-ingress/brazil
        header CF-Connecting-IP 216.238.121.92
    }
    handle @lk_webhook_brazil {
        rewrite * /brazil
        reverse_proxy 127.0.0.1:8500
    }
    handle /voice-ingress/* {
        respond 403
    }

    # File/media server (Autumn)
    handle_path /media/* {
        reverse_proxy 127.0.0.1:14704
    }

    # Link proxy (January)
    handle_path /proxy/* {
        reverse_proxy 127.0.0.1:14705
    }

    # Prometheus metrics are operator-only telemetry (route templates,
    # per-status latency histograms, account/login counters). Delta mounts
    # them at /metrics, which /api strips to — so block the public path here,
    # ahead of the /api/* proxy below (handle blocks match in source order).
    handle /api/metrics* {
        respond 403
    }

    # REST API (Delta) — proxied under /api, prefix stripped
    handle_path /api/* {
        reverse_proxy 127.0.0.1:14702
    }

    # API root discovery endpoint
    handle /api {
        reverse_proxy 127.0.0.1:14702
    }

    # App updates (desktop latest.json + installers, Android APKs)
    # CORS: the Android app fetches latest.json from origin https://localhost
    handle_path /updates/* {
        root * "/home/mcp/stoatchat/updates"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    # Unicode-emoji SVG packs — SELF-HOSTED since 2026-09-05. These were
    # reverse-proxied to static.stoat.chat, which left emoji rendering
    # dependent on upstream-operated infrastructure we do not control.
    #
    # The client needed no change at all: it has always requested these from
    # THIS origin (VITE_EMOJI_URL=https://app.sloga.gg/emoji), so the swap is
    # server-side only — no rebuild, no release, no CSP change. Nothing is
    # cache-busted either, because the URLs are identical.
    #
    # Files live at <root>/emoji/<pack>/<codepoint>.svg, which is exactly the
    # request path, so this stays `handle` (NOT handle_path) and the root maps
    # 1:1. All six packs the client can request are present
    # (fluent-3d/-color/-flat, mutant, noto, twemoji); re-mirror or fill gaps
    # with /home/mcp/emoji-build/mirror.sh <pack>.
    handle /emoji/* {
        root * /home/mcp/emoji-packs
        encode zstd gzip

        # Served same-origin, an SVG opened DIRECTLY (not via <img>) renders as
        # a document in app.sloga.gg, so a script inside one would run as us.
        # The mirrored files were scanned and carry no active content; this is
        # the belt-and-braces that keeps that true even if a future re-mirror
        # pulls something hostile. The upstream proxy had no such protection.
        header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        header X-Content-Type-Options "nosniff"
        # Immutable by construction: the filename IS the codepoint, and the
        # client additionally cache-busts with ?v=. Upstream sent max-age=14400.
        header Cache-Control "public, max-age=31536000, immutable"

        file_server
    }

    # Frontend — SPA static files (dist)
    handle {
        root * /home/mcp/frontend/packages/client/dist
        encode gzip

        # Security headers for the web client (audit 2026-09-05 H3). The CSP is
        # the policy proven against this same bundle on Android
        # (scripts/injectAndroidCsp.mjs) — on web `'self'` IS app.sloga.gg, so
        # the img/media/connect app.sloga.gg entries are already covered by
        # 'self'; kept verbatim for parity. Deltas vs the meta-CSP: this HTTP
        # header can and does add `frame-ancestors 'none'` (a meta tag cannot),
        # which the app never needs to be framed to work. script-src carries NO
        # 'unsafe-inline' — the served index.html has zero inline scripts
        # (verified 2026-09-05). Any XSS foothold therefore has no CSP-blessed
        # exfil sink, and the session token in browser storage stays behind it.
        header {
            Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://hcaptcha.com https://*.hcaptcha.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: blob: https://app.sloga.gg; media-src 'self' blob: https://app.sloga.gg; font-src 'self' data:; connect-src 'self' blob: https://app.sloga.gg wss://app.sloga.gg https://*.sloga.gg wss://*.sloga.gg https://translate.googleapis.com https://api.drand.sh https://hcaptcha.com https://*.hcaptcha.com https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; frame-src https://hcaptcha.com https://*.hcaptcha.com https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv https://open.spotify.com https://w.soundcloud.com https://bandcamp.com https://new.lightspeed.tv; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()"
            Strict-Transport-Security "max-age=31536000"
            -Server
        }

        try_files {path} /index.html
        file_server
    }
}

# Marketing site — sloga.gg apex (host-matched; app.sloga.gg + localhost still hit the :80 block above)
http://sloga.gg {
    root * /home/mcp/sloga-website

    # Security headers for the marketing site (audit 2026-09-05 H3). The site is
    # static and holds no session — so the CSP keeps 'unsafe-inline' for the
    # inline lang-redirect bootstrap and the logo animations, and allows the
    # discover page to fetch app.sloga.gg (the API) and load its media. The
    # high-value, low-risk protections still apply: no framing, no plugins, no
    # base-tag hijack, MIME-sniffing off, HSTS.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://app.sloga.gg; font-src 'self' data:; connect-src 'self' https://app.sloga.gg https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # Repo documentation is not site content. The live directory IS the source
    # folder, so README.md was served at the site root, describing the layout
    # and the deploy recipe (audit 2026-09-05 L8). Blocked here rather than
    # deleted, so a re-sync from the git source cannot quietly restore it.
    @repodocs path /README.md /readme.md
    respond @repodocs 404

    # The Linux .deb updater's "Open download page" button opens /download.
    # That URL is COMPILED INTO already-installed 0.1.0+ clients, so shipping a
    # corrected constant cannot fix them — this redirect is the only thing that
    # reaches existing installs. Do not remove while any deb client is in the
    # wild. (Quote the target: a bare # starts a Caddyfile comment.)
    redir /download "/#downloads" 302

    # ---- Download counting -------------------------------------------------
    # /dl/* are the STABLE public download links. index.html's buttons point
    # here instead of at the version-pinned /updates/ CDN paths, so a release
    # only has to change the four targets below — not the site HTML.
    #
    # Every /dl/* hit is logged to /var/log/caddy-downloads.log so totals can be
    # counted server-side (no JS, so ad blockers cannot suppress it). log_skip
    # keeps ordinary page requests OUT of the log — only /dl/* is recorded.
    #
    # The log is deliberately IP-FREE: the filter drops the entire header map
    # (CF-Connecting-IP and friends live there) plus remote_ip/client_ip,
    # because the published privacy policy claims Sloga keeps no IP logs.
    # Do NOT remove those delete lines or re-add headers without rewording the
    # policy first — that claim is load-bearing.
    #
    # Auto-updaters fetch /updates/* DIRECTLY and never pass through /dl/*, so
    # these counts are human downloads, not update churn.
    @dl path /dl/*
    @notdl not path /dl/*
    log_skip @notdl
    log {
        output file /var/log/caddy-downloads.log {
            mode 644
            roll_size 10mb
            roll_keep 20
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>tls delete
                resp_headers delete
            }
        }
    }
    header @dl Cache-Control "no-store"
    redir /dl/windows       "https://app.sloga.gg/updates/desktop/Sloga_0.57.0_x64-setup.exe" 302
    redir /dl/linux-deb     "https://app.sloga.gg/updates/desktop-linux/Sloga-0.57.0-linux-amd64.deb" 302
    redir /dl/linux-appimage "https://app.sloga.gg/updates/desktop-linux/Sloga-0.57.0-linux-x86_64.AppImage" 302
    redir /dl/android       "https://app.sloga.gg/updates/android/sloga-0.57.0.apk" 302

    # Short, stable URL for the account-deletion page. Google Play requires a web
    # URL where a user can request account + data deletion without reinstalling
    # the app, and this is what goes in the Data safety form — so it must keep
    # working even if legal/ is ever reorganised. 302 (not 301) deliberately:
    # browsers cache a 301 hard, which would strand anyone who followed it if the
    # target ever moves.
    redir /delete-account   /legal/delete-account.html 302

    file_server
}

# Machine-local site blocks (not tracked; glob = no error when empty)
import /home/mcp/caddy-local/*.caddy
