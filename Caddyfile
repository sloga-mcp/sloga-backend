# Sloga reverse proxy
# Upstreams use 127.0.0.1 (caddy + all backends share one WSL netns). Do NOT hardcode the
# WSL eth0 IP here — it changes with WSL networking mode (was 127.0.0.1 under NAT; the
# switch to mirrored mode on 2026-07-08 made that IP unreachable → every route 502'd).

# Global logging — redact credentials BEFORE they reach disk.
# Session tokens ride in the /ws query string (the browser WebSocket API cannot
# set request headers, so the token has to go in the URL) and in X-Session-Token
# on REST calls. Without this filter, every error entry writes a live, replayable
# session token into /var/log/caddy.log — anyone who can read that file can hijack
# those sessions. `wrap json` preserves the existing on-disk log format.
{
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                }
                request>headers>X-Session-Token delete
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }
}

:80 {

    # WebSocket (Bonfire)
    handle /ws {
        reverse_proxy 127.0.0.1:14703
    }

    # LiveKit RoomService admin API: server-side only (delta/voice-ingress
    # reach LiveKit directly, never through this proxy) — auth-gated by the
    # API secret, but there is no reason to expose the admin surface at all.
    handle /livekit/twirp/* {
        respond 403
    }

    # LiveKit voice (strip /livekit prefix, handles both /livekit and /livekit/*)
    handle /livekit* {
        uri strip_prefix /livekit
        reverse_proxy 127.0.0.1:7880
    }

    # File/media server (Autumn)
    handle_path /media/* {
        reverse_proxy 127.0.0.1:14704
    }

    # Link proxy (January)
    handle_path /proxy/* {
        reverse_proxy 127.0.0.1:14705
    }

    # REST API (Delta) — proxied under /api, prefix stripped
    handle_path /api/* {
        reverse_proxy 127.0.0.1:14702
    }

    # API root discovery endpoint
    handle /api {
        reverse_proxy 127.0.0.1:14702
    }

    # App updates (desktop latest.json + installers, Android APKs)
    # CORS: the Android app fetches latest.json from origin https://localhost
    handle_path /updates/* {
        root * "/home/mcp/stoatchat/updates"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    # Unicode-emoji SVG packs — proxied to the upstream pack host so the client
    # only ever requests them from the app origin (E2EE 6.2b: the desktop shell
    # CSP img-src has no external host; also the no-CDN policy). Keeps the
    # /emoji prefix (handle, not handle_path). Full self-hosting (vendor the
    # SVGs to disk + file_server) can replace the upstream later with no client
    # change. See VITE_EMOJI_URL / unicodeEmojiUrl.
    handle /emoji/* {
        reverse_proxy https://static.stoat.chat {
            header_up Host static.stoat.chat
        }
    }

    # Frontend — proxy to Vite dev server
    handle {
        reverse_proxy 127.0.0.1:5174
    }
}

# Marketing site — sloga.gg apex (host-matched; app.sloga.gg + localhost still hit the :80 block above)
http://sloga.gg {
    root * /home/mcp/sloga-website
    # The Linux .deb updater's "Open download page" button opens /download.
    # That URL is COMPILED INTO already-installed 0.1.0+ clients, so shipping a
    # corrected constant cannot fix them — this redirect is the only thing that
    # reaches existing installs. Do not remove while any deb client is in the
    # wild. (Quote the target: a bare # starts a Caddyfile comment.)
    redir /download "/#downloads" 302

    # ---- Download counting -------------------------------------------------
    # /dl/* are the STABLE public download links. index.html's buttons point
    # here instead of at the version-pinned /updates/ CDN paths, so a release
    # only has to change the four targets below — not the site HTML.
    #
    # Every /dl/* hit is logged to /var/log/caddy-downloads.log so totals can be
    # counted server-side (no JS, so ad blockers cannot suppress it). log_skip
    # keeps ordinary page requests OUT of the log — only /dl/* is recorded.
    #
    # The log is deliberately IP-FREE: the filter drops the entire header map
    # (CF-Connecting-IP and friends live there) plus remote_ip/client_ip,
    # because the published privacy policy claims Sloga keeps no IP logs.
    # Do NOT remove those delete lines or re-add headers without rewording the
    # policy first — that claim is load-bearing.
    #
    # Auto-updaters fetch /updates/* DIRECTLY and never pass through /dl/*, so
    # these counts are human downloads, not update churn.
    @dl path /dl/*
    @notdl not path /dl/*
    log_skip @notdl
    log {
        output file /var/log/caddy-downloads.log {
            mode 644
            roll_size 10mb
            roll_keep 20
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>tls delete
                resp_headers delete
            }
        }
    }
    header @dl Cache-Control "no-store"
    redir /dl/windows       "https://app.sloga.gg/updates/desktop/Sloga_0.35.0_x64-setup.exe" 302
    redir /dl/linux-deb     "https://app.sloga.gg/updates/desktop-linux/Sloga-0.21.0-linux-amd64.deb" 302
    redir /dl/linux-appimage "https://app.sloga.gg/updates/desktop-linux/Sloga-0.21.0-linux-x86_64.AppImage" 302
    redir /dl/android       "https://app.sloga.gg/updates/android/sloga-1.27.0.apk" 302

    # Short, stable URL for the account-deletion page. Google Play requires a web
    # URL where a user can request account + data deletion without reinstalling
    # the app, and this is what goes in the Data safety form — so it must keep
    # working even if legal/ is ever reorganised. 302 (not 301) deliberately:
    # browsers cache a 301 hard, which would strand anyone who followed it if the
    # target ever moves.
    redir /delete-account   /legal/delete-account.html 302

    file_server
}
